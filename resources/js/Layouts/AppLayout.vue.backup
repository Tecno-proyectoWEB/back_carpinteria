<template>
    <div class="min-h-screen bg-gray-100 flex">
        <!-- Sidebar - Siempre fijo en desktop -->
        <aside
            :class="[
                'fixed inset-y-0 left-0 z-50 w-64 bg-gray-900 text-white transform transition-transform duration-300 ease-in-out flex flex-col',
                sidebarOpen ? 'translate-x-0' : '-translate-x-full',
                'lg:translate-x-0'
            ]"
        >
            <!-- Logo y nombre -->
            <div class="flex items-center justify-between h-16 px-6 bg-gray-800 border-b border-gray-700">
                <h1 class="text-xl font-bold text-white">Carpintería Jorge</h1>
                <button
                    @click="sidebarOpen = false"
                    class="lg:hidden text-gray-400 hover:text-white transition-colors"
                >
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <!-- Menú de navegación -->
            <nav class="mt-6 px-3 space-y-1 overflow-y-auto flex-1">
                <template v-if="menuItems && menuItems.length > 0">
                    <Link
                        v-for="item in menuItems"
                        :key="`menu-${item.id || item.nombre}-${item.ruta || ''}`"
                        :href="item.ruta"
                        @click="handleMenuClick"
                        preserve-scroll
                        class="flex items-center px-4 py-3 text-sm font-medium rounded-lg transition-colors duration-150"
                        :class="isActive(item.ruta)
                            ? 'bg-blue-600 text-white'
                            : 'text-gray-300 hover:bg-gray-800 hover:text-white'"
                    >
                        <span class="mr-3 text-lg">{{ getIcon(item.icono) }}</span>
                        <span>{{ item.nombre }}</span>
                    </Link>
                </template>
                <div v-else-if="page.props.auth?.user" class="px-4 py-3 text-gray-400 text-sm">
                    <p>🔄 Cargando menú...</p>
                    <p class="text-xs mt-1 text-gray-500">Usuario: {{ page.props.auth.user.rol?.nombre || 'Sin rol' }}</p>
                    <p class="text-xs mt-1 text-gray-600">Path: {{ $page.url }}</p>
                    <p class="text-xs mt-1 text-gray-600">Props: {{ Object.keys(page.props).join(', ') }}</p>
                </div>
                <div v-else class="px-4 py-3 text-gray-400 text-sm">
                    <p>Inicia sesión para ver el menú</p>
                </div>
            </nav>

            <!-- Botón de cerrar sesión en la parte inferior -->
            <div class="border-t border-gray-700 p-4">
                <button
                    @click="logout"
                    class="w-full flex items-center px-4 py-3 text-sm font-medium text-gray-300 rounded-lg transition-colors duration-150 hover:bg-gray-800 hover:text-white"
                >
                    <span class="mr-3 text-lg">🚪</span>
                    <span>Cerrar Sesión</span>
                </button>
            </div>
        </aside>

        <!-- Overlay para móvil -->
        <div
            v-if="sidebarOpen"
            @click="sidebarOpen = false"
            class="fixed inset-0 bg-black bg-opacity-50 z-40 lg:hidden"
        ></div>

        <!-- Contenido principal - Siempre con padding izquierdo en desktop -->
        <div class="flex-1 flex flex-col min-h-screen lg:ml-64">
            <!-- Header superior -->
            <header class="bg-white shadow-sm border-b border-gray-200 sticky top-0 z-30">
                <div class="flex items-center justify-between h-16 px-4 sm:px-6 lg:px-8">
                    <!-- Botón menú móvil -->
                    <button
                        @click="sidebarOpen = !sidebarOpen"
                        class="lg:hidden p-2 rounded-md text-gray-400 hover:text-gray-500 hover:bg-gray-100 transition-colors"
                    >
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                        </svg>
                    </button>

                    <!-- Barra de búsqueda y controles -->
                    <div class="flex-1 flex items-center justify-end space-x-4 ml-4">
                        <div class="hidden md:block">
                            <SearchBar />
                        </div>

                        <ThemeSelector />

                        <button
                            @click="showAccessibility = !showAccessibility"
                            class="p-2 rounded-md text-gray-400 hover:text-gray-500 hover:bg-gray-100 transition-colors"
                            title="Accesibilidad"
                        >
                            ♿
                        </button>

                        <!-- Información del usuario -->
                        <div v-if="page.props.auth?.user" class="flex items-center space-x-3">
                            <div class="hidden sm:block text-right">
                                <p class="text-sm font-medium text-gray-900">
                                    {{ page.props.auth.user?.nombre }} {{ page.props.auth.user?.apellido }}
                                </p>
                                <p v-if="page.props.auth.user?.rol" class="text-xs text-gray-500">
                                    {{ page.props.auth.user.rol.nombre }}
                                </p>
                            </div>

                            <!-- Dropdown de usuario -->
                            <div class="relative">
                                <button
                                    @click="userMenuOpen = !userMenuOpen"
                                    class="flex items-center space-x-2 p-2 rounded-full hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-colors"
                                >
                                    <div class="w-8 h-8 bg-blue-600 rounded-full flex items-center justify-center text-white text-sm font-semibold">
                                        {{ getUserInitials() }}
                                    </div>
                                </button>

                                <!-- Menú desplegable -->
                                <div
                                    v-if="userMenuOpen"
                                    v-click-outside="() => userMenuOpen = false"
                                    class="absolute right-0 mt-2 w-48 bg-white rounded-md shadow-lg py-1 z-50 border border-gray-200"
                                >
                                    <button
                                        @click="logout"
                                        class="block w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 transition-colors"
                                    >
                                        Cerrar Sesión
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </header>

            <!-- Panel de accesibilidad (desplegable) -->
            <div v-if="showAccessibility" class="fixed right-4 top-20 z-50">
                <AccessibilityControls />
            </div>

            <!-- Mensajes Flash -->
            <div v-if="page.props.flash?.success" class="fixed top-20 right-4 z-50">
                <Alert type="success" :message="page.props.flash.success" />
            </div>
            <div v-if="page.props.flash?.error" class="fixed top-20 right-4 z-50">
                <Alert type="error" :message="page.props.flash.error" />
            </div>
            <div v-if="page.props.flash?.message" class="fixed top-20 right-4 z-50">
                <Alert type="info" :message="page.props.flash.message" />
            </div>

            <!-- Contenido de la página -->
            <main class="flex-1 bg-gray-50">
                <div class="py-6 px-4 sm:px-6 lg:px-8">
                    <slot />
                </div>
            </main>

            <!-- Footer -->
            <footer class="bg-white border-t border-gray-200 mt-auto">
                <div class="max-w-7xl mx-auto py-4 px-4 sm:px-6 lg:px-8">
                    <div class="flex flex-col sm:flex-row justify-between items-center text-sm text-gray-500 space-y-2 sm:space-y-0">
                        <div>
                            <p>&copy; {{ new Date().getFullYear() }} Carpintería Jorge. Todos los derechos reservados.</p>
                        </div>
                        <div v-if="pageVisits" class="text-right">
                            <p>Visitas: {{ pageVisits }}</p>
                        </div>
                    </div>
                </div>
            </footer>
        </div>
    </div>
</template>

<script setup>
import { ref, computed, watch, onMounted } from 'vue';
import { router, usePage, Link } from '@inertiajs/vue3';
import ThemeSelector from '@/Components/ThemeSelector.vue';
import AccessibilityControls from '@/Components/AccessibilityControls.vue';
import SearchBar from '@/Components/SearchBar.vue';
import Alert from '@/Components/UI/Alert.vue';

const page = usePage();

// Usar un ref para mantener los menuItems y asegurar reactividad
// Inicializar con los menuItems actuales si existen
const menuItemsRef = ref(Array.isArray(page.props.menuItems) ? page.props.menuItems : []);

// Función para actualizar el ref solo si hay items válidos o si no hay usuario
const updateMenuItems = (newItems, forceUpdate = false) => {
    const items = newItems ?? [];
    const validItems = Array.isArray(items) ? items : [];
    const hasUser = !!page.props.auth?.user;
    const hasPreviousItems = menuItemsRef.value.length > 0;

    // Si hay items válidos, siempre actualizar
    if (validItems.length > 0) {
        menuItemsRef.value = validItems;
        if (import.meta.env.DEV) {
            console.log('✅ Menú actualizado:', {
                count: validItems.length,
                items: validItems.map(i => i.nombre),
                path: window.location.pathname
            });
        }
        return;
    }

    // Si no hay items pero hay usuario autenticado, mantener los anteriores
    // Esto evita que el menú desaparezca durante la navegación
    if (hasUser && hasPreviousItems && !forceUpdate) {
        if (import.meta.env.DEV) {
            console.warn('⚠️ Menú vacío recibido, manteniendo items anteriores', {
                menuItemsRecibidos: newItems,
                menuItemsAnteriores: menuItemsRef.value.length,
                user: page.props.auth?.user,
                userRol: page.props.auth?.user?.rol,
                currentPath: window.location.pathname,
            });
        }
        // No actualizar, mantener los anteriores
        return;
    }

    // Si no hay usuario o se fuerza la actualización, actualizar a vacío
    menuItemsRef.value = [];
};

// Watch para detectar cambios en menuItems y actualizar el ref
watch(
    () => page.props.menuItems,
    (newItems) => {
        updateMenuItems(newItems);
    },
    { immediate: true, deep: true }
);

// También watch para cambios en el usuario autenticado
watch(
    () => page.props.auth?.user,
    (newUser, oldUser) => {
        // Si el usuario cambia (login/logout) y hay menuItems en props, actualizar
        if (newUser) {
            const items = page.props.menuItems ?? [];
            updateMenuItems(items, false);
        } else if (!newUser && oldUser) {
            // Si el usuario cerró sesión, limpiar el menú
            menuItemsRef.value = [];
        }
    },
    { immediate: true }
);

// Asegurar que el menú se cargue al montar el componente
onMounted(() => {
    // Si hay usuario pero no hay items en el ref, intentar cargar de props
    if (page.props.auth?.user && menuItemsRef.value.length === 0) {
        const items = page.props.menuItems ?? [];
        const validItems = Array.isArray(items) ? items : [];
        if (validItems.length > 0) {
            menuItemsRef.value = validItems;
            if (import.meta.env.DEV) {
                console.log('✅ Menú cargado en onMounted:', {
                    count: validItems.length,
                    items: validItems.map(i => i.nombre)
                });
            }
        }
    }
});

// SOLUCIÓN DEFINITIVA: Mantener menú persistente con localStorage como respaldo
// Esto asegura que el menú nunca desaparezca durante la navegación

// Inicializar desde localStorage si existe, o desde props
const getInitialMenuItems = () => {
    try {
        // Primero intentar desde localStorage (para persistencia entre reloads)
        const stored = localStorage.getItem('menuItems');
        if (stored) {
            const parsed = JSON.parse(stored);
            if (Array.isArray(parsed) && parsed.length > 0) {
                return parsed;
            }
        }
    } catch (e) {
        // Ignorar errores de localStorage
    }

    // Fallback a props actuales
    return Array.isArray(page.props.menuItems) ? page.props.menuItems : [];
};

const menuItemsRef = ref(getInitialMenuItems());

// Función para guardar en localStorage
const saveMenuItems = (items) => {
    try {
        if (Array.isArray(items) && items.length > 0) {
            localStorage.setItem('menuItems', JSON.stringify(items));
        }
    } catch (e) {
        // Ignorar errores de localStorage
    }
};

// Función para limpiar localStorage
const clearMenuItems = () => {
    try {
        localStorage.removeItem('menuItems');
        menuItemsRef.value = [];
    } catch (e) {
        // Ignorar errores
    }
};

// Watch principal: actualizar menú cuando llegan nuevos items desde el servidor
watch(
    () => page.props.menuItems,
    (newItems) => {
        const items = newItems ?? [];
        const validItems = Array.isArray(items) ? items : [];

        if (validItems.length > 0) {
            // Solo actualizar si son diferentes a los actuales
            const currentItems = JSON.stringify(menuItemsRef.value);
            const newItemsStr = JSON.stringify(validItems);

            if (currentItems !== newItemsStr) {
                menuItemsRef.value = validItems;
                saveMenuItems(validItems);

                if (import.meta.env.DEV) {
                    console.log('✅ Menú actualizado desde servidor:', {
                        count: validItems.length,
                        items: validItems.map(i => i.nombre),
                        path: window.location.pathname,
                        timestamp: new Date().toISOString()
                    });
                }
            }
        } else if (page.props.auth?.user) {
            // Si llegan items vacíos pero hay usuario, mantener los actuales
            // Esto evita que desaparezca durante navegación
            if (import.meta.env.DEV) {
                console.warn('⚠️ Items vacíos del servidor, manteniendo menú actual:', {
                    currentCount: menuItemsRef.value.length,
                    user: page.props.auth?.user,
                    path: window.location.pathname,
                    timestamp: new Date().toISOString()
                });
            }
        }
    },
    { immediate: true, deep: true }
);

// Watch para logout: limpiar menú
watch(
    () => page.props.auth?.user,
    (newUser, oldUser) => {
        if (!newUser && oldUser) {
            // Usuario cerró sesión
            clearMenuItems();
            if (import.meta.env.DEV) {
                console.log('🚪 Usuario cerró sesión, menú limpiado');
            }
        }
    },
    { immediate: true }
);

// Computed que siempre retorna el menú actual
const menuItems = computed(() => {
    // Si tenemos items en el ref, retornarlos
    if (menuItemsRef.value && menuItemsRef.value.length > 0) {
        return menuItemsRef.value;
    }

    // Si no hay items en el ref, intentar obtener de props actuales
    const items = page.props.menuItems ?? [];
    const validItems = Array.isArray(items) ? items : [];

    if (validItems.length > 0) {
        menuItemsRef.value = validItems;
        saveMenuItems(validItems);
        return validItems;
    }

    // Último fallback: array vacío
    return [];
});
const pageVisits = computed(() => page.props.pageVisits ?? null);

const sidebarOpen = ref(false);
const showAccessibility = ref(false);
const userMenuOpen = ref(false);

// Manejar clic en menú (cerrar sidebar en móvil)
const handleMenuClick = () => {
    // Cerrar sidebar en móvil cuando se hace clic en un item
    if (window.innerWidth < 1024) {
        sidebarOpen.value = false;
    }
};

// Verificar si una ruta está activa
const isActive = (ruta) => {
    if (!ruta) return false;
    const currentPath = window.location.pathname;

    // Extraer solo la ruta relativa si es una URL completa
    let routePath = ruta;
    try {
        const url = new URL(ruta, window.location.origin);
        routePath = url.pathname;
    } catch (e) {
        // Si no es una URL válida, usar la ruta tal cual
        routePath = ruta;
    }

    // Normalizar rutas para comparación (sin trailing slash)
    const normalizedRuta = routePath.replace(/\/$/, '');
    const normalizedPath = currentPath.replace(/\/$/, '');

    // Comparar exactamente o si la ruta actual comienza con la ruta del menú
    return normalizedPath === normalizedRuta || normalizedPath.startsWith(normalizedRuta + '/');
};

// Obtener icono según el nombre
const getIcon = (icono) => {
    const icons = {
        home: '🏠',
        box: '📦',
        tools: '🔧',
        package: '📋',
        'shopping-cart': '🛒',
        'shopping-bag': '🛍️',
        users: '👥',
        'chart-bar': '📊',
        warehouse: '🏭',
        list: '📝',
        shield: '🛡️',
    };
    return icons[icono] || '📄';
};

// Obtener iniciales del usuario
const getUserInitials = () => {
    const user = page.props.auth?.user;
    if (!user) return 'U';
    const nombre = user.nombre?.charAt(0) || '';
    const apellido = user.apellido?.charAt(0) || '';
    return (nombre + apellido).toUpperCase() || 'U';
};

const logout = () => {
    router.post('/logout');
};

// Directiva para cerrar menú al hacer click fuera
const vClickOutside = {
    mounted(el, binding) {
        el.clickOutsideEvent = (event) => {
            if (!(el === event.target || el.contains(event.target))) {
                binding.value();
            }
        };
        document.addEventListener('click', el.clickOutsideEvent);
    },
    unmounted(el) {
        document.removeEventListener('click', el.clickOutsideEvent);
    },
};
</script>
